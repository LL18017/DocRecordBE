# Copiar como .env (ya ignorado por Git) y completar.
# docker-compose.yml lee este archivo automaticamente.

DB_NAME=datadoc
DB_USER=postgres
DB_PASSWORD=9902

PGADMIN_EMAIL=admin@docrecord.sv
PGADMIN_PASSWORD=admin

# Contrasena de aplicacion de Google para el envio de correos. Sin valor por
# defecto: vacia, el arranque funciona pero no salen correos. Pedirla al equipo.
# Ojo: Spring Boot NO lee este archivo — para que le llegue hay que exportarla
# en la terminal. Docker Compose si lo lee, para las variables DB_*.
MAIL_PASSWORD=

# JWT. Igual que MAIL_PASSWORD, hay que exportarlos en la terminal para que
# Spring Boot los vea.
#
# JWT_SECRET firma los tokens. OBLIGATORIO: no tiene valor por defecto y sin el
# la aplicacion no arranca. En local, la salida facil es el perfil `dev`
# (SPRING_PROFILES_ACTIVE=dev), que trae una clave marcada SOLO DESARROLLO.
# Base64URL, minimo 32 bytes decodificados (HMAC-SHA256). Generar con:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
JWT_SECRET=

# Duraciones en milisegundos. Por defecto: 900000 = 15 min de access token
# (viaja en cada peticion, por eso corto) y 604800000 = 7 dias de refresh
# token (para que la sesion sobreviva la jornada de trabajo).
JWT_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=

# CORS. Origenes del navegador permitidos, separados por comas. Por defecto:
# http://localhost:3000, https://docrecordsv.duckdns.org y
# https://api-docrecordsv.duckdns.org. Cualquier otro origen es rechazado.
CORS_ORIGENES=
