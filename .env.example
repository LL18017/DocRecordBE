# Copiar como .env (ya ignorado por Git) y completar.
# docker-compose.yml lee este archivo automaticamente.

DB_NAME=datadoc
DB_USER=postgres
DB_PASSWORD=9902

PGADMIN_EMAIL=admin@docrecord.sv
PGADMIN_PASSWORD=admin

# Opcional. application.properties ya trae un valor por defecto que funciona;
# esto solo sirve para sobreescribirlo (por ejemplo, tras rotar la clave).
# Ojo: Spring Boot NO lee este archivo — para que le llegue hay que exportarla
# en la terminal. Docker Compose si lo lee, para las variables DB_*.
MAIL_PASSWORD=

# JWT. Igual que MAIL_PASSWORD: application.properties ya trae valores por
# defecto que funcionan en local, esto solo sirve para sobreescribirlos, y hay
# que exportarlos en la terminal para que Spring Boot los vea.
#
# JWT_SECRET firma los tokens. OBLIGATORIO en cualquier despliegue real: el
# valor por defecto esta en el repositorio publico, asi que sirve para
# desarrollo y para nada mas. Base64URL, minimo 32 bytes decodificados
# (HMAC-SHA256). Generar con:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
JWT_SECRET=

# Duraciones en milisegundos. Por defecto: 900000 = 15 min de access token
# (viaja en cada peticion, por eso corto) y 604800000 = 7 dias de refresh
# token (para que la sesion sobreviva la jornada de trabajo).
JWT_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=
