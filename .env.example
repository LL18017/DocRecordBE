# Copiar como .env (ya ignorado por Git) y completar.
# docker-compose.yml lee este archivo automaticamente.

DB_NAME=datadoc
DB_USER=postgres
DB_PASSWORD=9902

PGADMIN_EMAIL=admin@docrecord.sv
PGADMIN_PASSWORD=admin

# Opcional. application.properties ya trae un valor por defecto que funciona;
# esto solo sirve para sobreescribirlo (por ejemplo, tras rotar la clave).
# Ojo: Spring Boot NO lee este archivo — para que le llegue hay que exportarla
# en la terminal. Docker Compose si lo lee, para las variables DB_*.
MAIL_PASSWORD=
