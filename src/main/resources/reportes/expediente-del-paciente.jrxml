<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="expediente_del_paciente" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35"
              whenNoDataType="AllSectionsNoDetail" uuid="8c0a4f2e-34a1-4b7d-9f5e-1d0b3c6a2e91">

    <style name="Titulo" fontName="SansSerif" fontSize="20" isBold="true" forecolor="#1E3A5F"/>
    <style name="Seccion" fontName="SansSerif" fontSize="12" isBold="true" forecolor="#1E3A5F"/>
    <style name="Texto" fontName="SansSerif" fontSize="10" forecolor="#1E293B"/>
    <style name="Etiqueta" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#64748B"/>

    <!-- HU-34 c5: el expediente del paciente en PDF. Mismo aspecto que la receta (nueva-prescripcion.jrxml).
         Cada renglon es una entrada de una seccion (una alergia, una consulta, una receta, una cita, un
         termino del glosario): las secciones salen del grupo por `seccion`, asi que el orden de la lista es
         el orden del documento. Lo arma PortalDelPacienteService. -->
    <parameter name="nombrePaciente" class="java.lang.String"/>
    <parameter name="expediente" class="java.lang.String"/>
    <parameter name="datosPersonales" class="java.lang.String"/>
    <parameter name="generadoEn" class="java.lang.String"/>

    <!-- La fuente de datos debe contener objetos con getters: getSeccion(), getTitulo(), getDetalle(), getMarca(). -->
    <field name="seccion" class="java.lang.String"/>
    <field name="titulo" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <field name="marca" class="java.lang.String"/>

    <group name="seccion">
        <groupExpression><![CDATA[$F{seccion}]]></groupExpression>
        <groupHeader>
            <band height="34" splitType="Prevent">
                <textField>
                    <reportElement style="Seccion" x="0" y="10" width="515" height="18"/>
                    <textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="30" width="515" height="1" forecolor="#D7DEE8"/>
                </line>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="150" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="515" height="28" forecolor="#1E3A5F"/>
                <textElement><font fontName="SansSerif" size="22" isBold="true"/></textElement>
                <text><![CDATA[DocRecord Sv]]></text>
            </staticText>
            <rectangle>
                <reportElement x="0" y="35" width="515" height="4" backcolor="#1E3A5F" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Titulo" x="0" y="52" width="515" height="30"/>
                <text><![CDATA[Mi expediente clínico]]></text>
            </staticText>

            <staticText>
                <reportElement style="Etiqueta" x="0" y="88" width="300" height="16"/>
                <text><![CDATA[PACIENTE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="104" width="300" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nombrePaciente}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Texto" positionType="Float" stretchType="RelativeToTallestObject" x="0" y="122" width="300" height="16"/>
                <textFieldExpression><![CDATA[$P{datosPersonales}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Etiqueta" x="320" y="88" width="195" height="16"/>
                <text><![CDATA[EXPEDIENTE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="320" y="104" width="195" height="18"/>
                <textFieldExpression><![CDATA[$P{expediente}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="320" y="122" width="195" height="16" forecolor="#64748B"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{generadoEn} == null ? "" : "Generado el " + $P{generadoEn}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="40" splitType="Prevent">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="4" width="400" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{titulo}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="400" y="4" width="115" height="16" forecolor="#B91C1C">
                    <printWhenExpression><![CDATA[$F{marca} != null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Texto" positionType="Float" x="0" y="20" width="515" height="16">
                    <printWhenExpression><![CDATA[$F{detalle} != null && !$F{detalle}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{detalle}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="4" width="515" height="14" forecolor="#94A3B8"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="58" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="18" width="515" height="36" forecolor="#64748B"/>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <text><![CDATA[Este documento contiene información médica confidencial. Consérvalo de forma segura. Es una copia de consulta: si algún dato no es correcto, pide en tu clínica que lo corrijan. Las explicaciones del glosario son orientativas; la interpretación de tus resultados corresponde a tu médico.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
