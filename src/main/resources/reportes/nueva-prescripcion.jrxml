<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="nueva_prescripcion" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35"
              whenNoDataType="AllSectionsNoDetail" uuid="2bfae6d0-5c10-4e9d-a61f-1d4f74e7a610">

    <style name="Titulo" fontName="SansSerif" fontSize="20" isBold="true" forecolor="#1E3A5F"/>
    <style name="Subtitulo" fontName="SansSerif" fontSize="12" isBold="true" forecolor="#1E3A5F"/>
    <style name="Texto" fontName="SansSerif" fontSize="10" forecolor="#1E293B"/>
    <style name="Etiqueta" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#64748B"/>
    <style name="CabeceraTabla" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#FFFFFF" backcolor="#1E3A5F" mode="Opaque"/>
    <style name="Celda" fontName="SansSerif" fontSize="9" forecolor="#1E293B"/>

    <!-- HU-22: la receta impresa lleva medico con su numero de junta de vigilancia y los datos de la clinica.
         Todos los parametros son opcionales: el correo de emision solo manda los tres primeros. -->
    <parameter name="nombrePaciente" class="java.lang.String"/>
    <parameter name="nombreMedico" class="java.lang.String"/>
    <parameter name="fecha" class="java.lang.String"/>
    <parameter name="expediente" class="java.lang.String"/>
    <parameter name="registroJunta" class="java.lang.String"/>
    <parameter name="fechaConsulta" class="java.lang.String"/>
    <parameter name="clinicaNombre" class="java.lang.String"/>
    <parameter name="clinicaDireccion" class="java.lang.String"/>
    <parameter name="clinicaTelefono" class="java.lang.String"/>
    <parameter name="anulada" class="java.lang.String"/>

    <!-- La fuente de datos debe contener objetos con getters: getMedicamento(), getDosis(), getViaAdministracion(), getFrecuencia(), getDuracion(). -->
    <field name="medicamento" class="java.lang.String"/>
    <field name="dosis" class="java.lang.String"/>
    <field name="viaAdministracion" class="java.lang.String"/>
    <field name="frecuencia" class="java.lang.String"/>
    <field name="duracion" class="java.lang.String"/>

    <title>
        <band height="280" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="515" height="28" forecolor="#1E3A5F"/>
                <textElement><font fontName="SansSerif" size="22" isBold="true"/></textElement>
                <text><![CDATA[DocRecord Sv]]></text>
            </staticText>
            <rectangle>
                <reportElement x="0" y="35" width="515" height="4" backcolor="#1E3A5F" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Titulo" x="0" y="52" width="515" height="30"/>
                <text><![CDATA[Prescripción médica]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="84" width="515" height="16" forecolor="#B91C1C">
                    <printWhenExpression><![CDATA[$P{anulada} != null]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{anulada}]]></textFieldExpression>
            </textField>

            <!-- Clinica -->
            <staticText>
                <reportElement style="Etiqueta" x="0" y="108" width="515" height="16"/>
                <text><![CDATA[CLÍNICA]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="124" width="515" height="16"/>
                <textFieldExpression><![CDATA[$P{clinicaNombre}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="140" width="515" height="16"/>
                <textFieldExpression><![CDATA[$P{clinicaDireccion}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="156" width="515" height="16"/>
                <textFieldExpression><![CDATA[$P{clinicaTelefono} == null ? "" : "Tel. " + $P{clinicaTelefono}]]></textFieldExpression>
            </textField>

            <!-- Paciente y medico -->
            <staticText>
                <reportElement style="Etiqueta" x="0" y="182" width="250" height="16"/>
                <text><![CDATA[PACIENTE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="198" width="250" height="18"/>
                <textFieldExpression><![CDATA[$P{nombrePaciente}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="216" width="250" height="16"/>
                <textFieldExpression><![CDATA[$P{expediente} == null ? "" : "Expediente " + $P{expediente}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Etiqueta" x="270" y="182" width="245" height="16"/>
                <text><![CDATA[MÉDICO RESPONSABLE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="270" y="198" width="245" height="18"/>
                <textFieldExpression><![CDATA[$P{nombreMedico}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="270" y="216" width="245" height="16"/>
                <textFieldExpression><![CDATA[$P{registroJunta} == null ? "" : "Junta de vigilancia: " + $P{registroJunta}]]></textFieldExpression>
            </textField>

            <!-- Fechas -->
            <staticText>
                <reportElement style="Etiqueta" x="0" y="240" width="250" height="16"/>
                <text><![CDATA[FECHA DE EMISIÓN]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="0" y="256" width="250" height="18"/>
                <textFieldExpression><![CDATA[$P{fecha}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Etiqueta" x="270" y="240" width="245" height="16">
                    <printWhenExpression><![CDATA[$P{fechaConsulta} != null]]></printWhenExpression>
                </reportElement>
                <text><![CDATA[FECHA DE LA CONSULTA]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Texto" x="270" y="256" width="245" height="18"/>
                <textFieldExpression><![CDATA[$P{fechaConsulta}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28" splitType="Stretch">
            <staticText>
                <reportElement style="CabeceraTabla" x="0" y="0" width="140" height="28"/>
                <box leftPadding="7"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Medicamento]]></text>
            </staticText>
            <staticText>
                <reportElement style="CabeceraTabla" x="140" y="0" width="80" height="28"/>
                <box leftPadding="7"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Dosis]]></text>
            </staticText>
            <staticText>
                <reportElement style="CabeceraTabla" x="220" y="0" width="80" height="28"/>
                <box leftPadding="7"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Vía]]></text>
            </staticText>
            <staticText>
                <reportElement style="CabeceraTabla" x="300" y="0" width="120" height="28"/>
                <box leftPadding="7"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Frecuencia]]></text>
            </staticText>
            <staticText>
                <reportElement style="CabeceraTabla" x="420" y="0" width="95" height="28"/>
                <box leftPadding="7"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Duración]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="34" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="34" backcolor="#F1F5F9" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.3" lineColor="#D7DEE8"/></graphicElement>
            </rectangle>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Celda" x="0" y="0" width="140" height="34"/>
                <box leftPadding="7" rightPadding="5"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{medicamento} == null || $F{medicamento}.trim().isEmpty() ? "No especificado" : $F{medicamento}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Celda" x="140" y="0" width="80" height="34"/>
                <box leftPadding="7" rightPadding="5"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{dosis} == null || $F{dosis}.trim().isEmpty() ? "No especificada" : $F{dosis}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Celda" x="220" y="0" width="80" height="34"/>
                <box leftPadding="7" rightPadding="5"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{viaAdministracion} == null || $F{viaAdministracion}.trim().isEmpty() ? "No especificada" : $F{viaAdministracion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Celda" x="300" y="0" width="120" height="34"/>
                <box leftPadding="7" rightPadding="5"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{frecuencia} == null || $F{frecuencia}.trim().isEmpty() ? "No especificada" : $F{frecuencia}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Celda" x="420" y="0" width="95" height="34"/>
                <box leftPadding="7" rightPadding="5"><pen lineColor="#D7DEE8"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{duracion} == null || $F{duracion}.trim().isEmpty() ? "No especificada" : $F{duracion}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="58" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="18" width="515" height="36" forecolor="#64748B"/>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <text><![CDATA[Este documento contiene información médica confidencial. Consérvalo de forma segura. Para aclaraciones sobre el tratamiento, contacta al médico responsable.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
